      {
        "name": "maintenance_windows",
        "description": "Scheduled and deferred maintenance windows, including the five-day PKG-02 preventive maintenance conflict.",
        "columns": [
          {
            "name": "maintenanceWindowId",
            "dataType": "string",
            "sourceColumn": "maintenanceWindowId",
            "summarizeBy": "none"
          },
          {
            "name": "lineId",
            "dataType": "string",
            "sourceColumn": "lineId",
            "summarizeBy": "none"
          },
          {
            "name": "maintenanceType",
            "dataType": "string",
            "sourceColumn": "maintenanceType",
            "summarizeBy": "none"
          },
          {
            "name": "originalStartDate",
            "dataType": "dateTime",
            "sourceColumn": "originalStartDate",
            "summarizeBy": "none"
          },
          {
            "name": "originalEndDate",
            "dataType": "dateTime",
            "sourceColumn": "originalEndDate",
            "summarizeBy": "none"
          },
          {
            "name": "durationDays",
            "dataType": "int64",
            "sourceColumn": "durationDays",
            "summarizeBy": "sum"
          },
          {
            "name": "operatingDaysLost",
            "dataType": "int64",
            "sourceColumn": "operatingDaysLost",
            "summarizeBy": "sum"
          },
          {
            "name": "deferredStartDate",
            "dataType": "dateTime",
            "sourceColumn": "deferredStartDate",
            "summarizeBy": "none"
          },
          {
            "name": "deferredEndDate",
            "dataType": "dateTime",
            "sourceColumn": "deferredEndDate",
            "summarizeBy": "none"
          },
          {
            "name": "deferralDays",
            "dataType": "int64",
            "sourceColumn": "deferralDays",
            "summarizeBy": "sum"
          },
          {
            "name": "lastMajorMaintenanceDate",
            "dataType": "dateTime",
            "sourceColumn": "lastMajorMaintenanceDate",
            "summarizeBy": "none"
          },
          {
            "name": "insideCampaignPeriod",
            "dataType": "boolean",
            "sourceColumn": "insideCampaignPeriod",
            "summarizeBy": "none"
          },
          {
            "name": "deferredOutsideCampaignPeriod",
            "dataType": "boolean",
            "sourceColumn": "deferredOutsideCampaignPeriod",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "maintenance_windows-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "maintenance_windows"
            }
          }
        ],
        "measures": [
          {
            "name": "Maintenance Operating Days Lost",
            "expression": "CALCULATE(\n    MAX('maintenance_windows'[operatingDaysLost]),\n    KEEPFILTERS('maintenance_windows'[maintenanceWindowId] = \"MW-PKG-02-2026-09\")\n)",
            "formatString": "#,0",
            "displayFolder": "Maintenance",
            "description": "Operating days lost to the PKG-02 campaign maintenance window. Unit: days."
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "MW-PKG-02-2026-09 is the five-day maintenance window that causes the capacity shortfall."
          }
        ]
      },
      {
        "name": "maintenance_policy_evaluations",
        "description": "Policy evaluation results for each production option, including permitted deferral days and stress ceiling checks.",
        "columns": [
          {
            "name": "optionId",
            "dataType": "string",
            "sourceColumn": "optionId",
            "summarizeBy": "none"
          },
          {
            "name": "policyId",
            "dataType": "string",
            "sourceColumn": "policyId",
            "summarizeBy": "none"
          },
          {
            "name": "policyVersion",
            "dataType": "double",
            "sourceColumn": "policyVersion",
            "summarizeBy": "none"
          },
          {
            "name": "sustainedRateFactor",
            "dataType": "double",
            "sourceColumn": "sustainedRateFactor",
            "summarizeBy": "average"
          },
          {
            "name": "requiredUtilisation",
            "dataType": "double",
            "sourceColumn": "requiredUtilisation",
            "summarizeBy": "average"
          },
          {
            "name": "requestedDeferralDays",
            "dataType": "int64",
            "sourceColumn": "requestedDeferralDays",
            "summarizeBy": "sum"
          },
          {
            "name": "permittedDeferralDays",
            "dataType": "int64",
            "sourceColumn": "permittedDeferralDays",
            "summarizeBy": "sum",
            "description": "Maximum maintenance deferral days permitted by policy for the option."
          },
          {
            "name": "projectedStressIndex",
            "dataType": "double",
            "sourceColumn": "projectedStressIndex",
            "summarizeBy": "sum"
          },
          {
            "name": "projectedStressPctOfThreshold",
            "dataType": "double",
            "sourceColumn": "projectedStressPctOfThreshold",
            "summarizeBy": "average",
            "description": "Projected cumulative stress as a percent of the threshold."
          },
          {
            "name": "stressCeilingPct",
            "dataType": "int64",
            "sourceColumn": "stressCeilingPct",
            "summarizeBy": "average",
            "description": "Policy ceiling for projected stress percent."
          },
          {
            "name": "withinStressCeiling",
            "dataType": "boolean",
            "sourceColumn": "withinStressCeiling",
            "summarizeBy": "none"
          },
          {
            "name": "policyPass",
            "dataType": "boolean",
            "sourceColumn": "policyPass",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "maintenance_policy_evaluations-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "maintenance_policy_evaluations"
            }
          }
        ],
        "measures": [
          {
            "name": "Permitted Deferral Days",
            "expression": "CALCULATE(\n    MAX('maintenance_policy_evaluations'[permittedDeferralDays]),\n    KEEPFILTERS('maintenance_policy_evaluations'[optionId] = \"OPT-4\")\n)",
            "formatString": "#,0",
            "displayFolder": "Maintenance",
            "description": "Deferral days permitted by POL-MAINT-002 for OPT-4. Unit: days."
          },
          {
            "name": "Projected Stress % of Threshold",
            "expression": "CALCULATE(\n    MAX('maintenance_policy_evaluations'[projectedStressPctOfThreshold]),\n    KEEPFILTERS('maintenance_policy_evaluations'[optionId] = \"OPT-4\")\n)",
            "formatString": "0.00",
            "displayFolder": "Maintenance",
            "description": "Projected equipment stress for OPT-4 as a percent of the threshold. Unit: percentage points."
          },
          {
            "name": "Stress Ceiling %",
            "expression": "CALCULATE(\n    MAX('maintenance_policy_evaluations'[stressCeilingPct]),\n    KEEPFILTERS('maintenance_policy_evaluations'[optionId] = \"OPT-4\")\n)",
            "formatString": "0.00",
            "displayFolder": "Maintenance",
            "description": "Maximum stress percent allowed by POL-MAINT-002. Unit: percentage points."
          }
        ]
      },
