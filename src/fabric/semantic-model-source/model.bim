          },
          {
            "name": "modelVersion",
            "dataType": "double",
            "sourceColumn": "modelVersion",
            "summarizeBy": "none"
          },
          {
            "name": "provenance",
            "dataType": "string",
            "sourceColumn": "provenance",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "weather_demand_response-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "weather_demand_response"
            }
          }
        ],
        "measures": [
          {
            "name": "Modelled Weather Uplift %",
            "expression": "VAR StartDate = DATE(2026, 6, 22)\nVAR EndDate = DATE(2026, 8, 2)\nRETURN\n    ROUND(\n        CALCULATE(\n            AVERAGE('weather_demand_response'[modelledUpliftPct]),\n            FILTER(\n                'weather_demand_response',\n                'weather_demand_response'[observationDate] >= StartDate\n                    && 'weather_demand_response'[observationDate] <= EndDate\n            )\n        ),\n        1\n    )",
            "formatString": "0.0",
            "displayFolder": "Weather",
            "description": "Mean modelled weather uplift over the variance window; by region it equals observed sales variance. Unit: percentage points."
          },
          {
            "name": "Weather Uplift vs Sales Variance Delta %",
            "expression": "[Modelled Weather Uplift %] - [Actual Sales Variance %]",
            "formatString": "0.0",
            "displayFolder": "Weather",
            "description": "Difference between modelled weather uplift and observed sales variance. Unit: percentage points."
          },
          {
            "name": "Mean UV Anomaly",
            "expression": "VAR StartDate = DATE(2026, 6, 22)\nVAR EndDate = DATE(2026, 8, 2)\nRETURN\n    CALCULATE(\n        AVERAGE('weather_demand_response'[uvIndexAnomaly]),\n        FILTER(\n            'weather_demand_response',\n            'weather_demand_response'[observationDate] >= StartDate\n                && 'weather_demand_response'[observationDate] <= EndDate\n        )\n    )",
            "formatString": "0.000",
            "displayFolder": "Weather",
            "description": "Mean UV index anomaly over the Hydration Sunscreen variance window. Unit: UV index points."
          },
          {
            "name": "Mean Temperature Anomaly C",
            "expression": "VAR StartDate = DATE(2026, 6, 22)\nVAR EndDate = DATE(2026, 8, 2)\nRETURN\n    CALCULATE(\n        AVERAGE('weather_demand_response'[temperatureMeanAnomalyC]),\n        FILTER(\n            'weather_demand_response',\n            'weather_demand_response'[observationDate] >= StartDate\n                && 'weather_demand_response'[observationDate] <= EndDate\n        )\n    )",
            "formatString": "0.000",
            "displayFolder": "Weather",
            "description": "Mean temperature anomaly over the Hydration Sunscreen variance window. Unit: degrees Celsius."
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "Use Modelled Weather Uplift % to explain why Hydration Sunscreen is above forecast."
          }
        ]
      },
