      {
        "name": "decision_corrections",
        "description": "Approved lessons learned and business corrections captured from a resolved decision case.",
        "columns": [
          {
            "name": "correctionId",
            "dataType": "string",
            "sourceColumn": "correctionId",
            "summarizeBy": "none",
            "description": "Approved lesson-learned or correction identifier."
          },
          {
            "name": "caseId",
            "dataType": "string",
            "sourceColumn": "caseId",
            "summarizeBy": "none"
          },
          {
            "name": "statement",
            "dataType": "string",
            "sourceColumn": "statement",
            "summarizeBy": "none"
          },
          {
            "name": "scopeKey",
            "dataType": "string",
            "sourceColumn": "scopeKey",
            "summarizeBy": "none"
          },
          {
            "name": "proposedByRole",
            "dataType": "string",
            "sourceColumn": "proposedByRole",
            "summarizeBy": "none"
          },
          {
            "name": "proposedAt",
            "dataType": "dateTime",
            "sourceColumn": "proposedAt",
            "summarizeBy": "none"
          },
          {
            "name": "approvedByRole",
            "dataType": "string",
            "sourceColumn": "approvedByRole",
            "summarizeBy": "none"
          },
          {
            "name": "approvedAt",
            "dataType": "dateTime",
            "sourceColumn": "approvedAt",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "decision_corrections-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "decision_corrections"
            }
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "CORR-2026-001 is available only when the post-decision outcome slice is loaded."
          }
        ],
        "measures": [
          {
            "name": "Approved Corrections Count",
            "expression": "CALCULATE(\n    DISTINCTCOUNT('decision_corrections'[correctionId]),\n    KEEPFILTERS('decision_corrections'[status] = \"approved\")\n)",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of approved corrections or lessons learned captured from decision cases. Unit: corrections."
          }
        ]
      },
      {
        "name": "decision_outcomes",
        "description": "Measured outcomes for remembered decisions, populated when the outcome slice is loaded.",
        "columns": [
          {
            "name": "outcomeId",
            "dataType": "string",
            "sourceColumn": "outcomeId",
            "summarizeBy": "none"
          },
          {
            "name": "caseId",
            "dataType": "string",
            "sourceColumn": "caseId",
            "summarizeBy": "none"
          },
          {
            "name": "metricName",
            "dataType": "string",
            "sourceColumn": "metricName",
            "summarizeBy": "none",
            "description": "Outcome metric name, such as incrementalUnitsDelivered or incrementalRevenueUsd."
          },
          {
            "name": "metricValue",
            "dataType": "double",
            "sourceColumn": "metricValue",
            "summarizeBy": "average",
            "formatString": "#,0.00",
            "description": "Observed outcome value for the metric."
          },
          {
            "name": "plannedValue",
            "dataType": "double",
            "sourceColumn": "plannedValue",
            "summarizeBy": "average",
            "formatString": "#,0.00",
            "description": "Planned comparison value for the outcome metric."
          },
          {
            "name": "resultCode",
            "dataType": "string",
            "sourceColumn": "resultCode",
            "summarizeBy": "none"
          },
          {
            "name": "recordedAt",
            "dataType": "dateTime",
            "sourceColumn": "recordedAt",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "decision_outcomes-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "decision_outcomes"
            }
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "Outcome rows for CASE-2026-HS-001 are available only in the opt-in outcome slice."
          }
        ],
        "measures": [
          {
            "name": "Decision Outcome Count",
            "expression": "DISTINCTCOUNT('decision_outcomes'[outcomeId])",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of measured outcomes captured for remembered decisions. Unit: outcomes."
          },
          {
            "name": "Outcome Planned Incremental Units",
            "expression": "CALCULATE(\n    SUM('decision_outcomes'[plannedValue]),\n    KEEPFILTERS('decision_outcomes'[metricName] = \"incrementalUnitsDelivered\")\n)",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Planned incremental units for the remembered Hydration Sunscreen decision. Unit: units."
          },
          {
            "name": "Outcome Delivered Incremental Units",
            "expression": "CALCULATE(\n    SUM('decision_outcomes'[metricValue]),\n    KEEPFILTERS('decision_outcomes'[metricName] = \"incrementalUnitsDelivered\")\n)",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Delivered incremental units from recorded decision outcomes. Unit: units."
          },
          {
            "name": "Outcome Incremental Units Variance",
            "expression": "[Outcome Delivered Incremental Units] - [Outcome Planned Incremental Units]",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Difference between delivered and planned incremental units for the remembered decision. Unit: units."
          },
          {
            "name": "Outcome Planned Incremental Revenue USD",
            "expression": "CALCULATE(\n    SUM('decision_outcomes'[plannedValue]),\n    KEEPFILTERS('decision_outcomes'[metricName] = \"incrementalRevenueUsd\")\n)",
            "formatString": "$#,0",
            "displayFolder": "Decision memory",
            "description": "Planned incremental revenue for the remembered Hydration Sunscreen decision. Unit: US dollars."
          },
          {
            "name": "Outcome Realised Incremental Revenue USD",
            "expression": "CALCULATE(\n    SUM('decision_outcomes'[metricValue]),\n    KEEPFILTERS('decision_outcomes'[metricName] = \"incrementalRevenueUsd\")\n)",
            "formatString": "$#,0",
            "displayFolder": "Decision memory",
            "description": "Realised incremental revenue from recorded decision outcomes. Unit: US dollars."
          },
          {
            "name": "Outcome Incremental Revenue Variance USD",
            "expression": "[Outcome Realised Incremental Revenue USD] - [Outcome Planned Incremental Revenue USD]",
            "formatString": "$#,0",
            "displayFolder": "Decision memory",
            "description": "Difference between realised and planned incremental revenue for the remembered decision. Unit: US dollars."
          },
          {
            "name": "Outcome Stress % at Maintenance",
            "expression": "CALCULATE(\n    MAX('decision_outcomes'[metricValue]),\n    KEEPFILTERS('decision_outcomes'[metricName] = \"stressPctOfThresholdAtMaintenance\")\n)",
            "formatString": "0.00",
            "displayFolder": "Decision memory",
            "description": "Stress outcome at deferred maintenance for the remembered production decision. Unit: percentage points."
          },
          {
            "name": "Outcome Existing Order Fulfilment %",
            "expression": "CALCULATE(\n    MAX('decision_outcomes'[metricValue]),\n    KEEPFILTERS('decision_outcomes'[metricName] = \"existingOrderFulfilmentPct\")\n)",
            "formatString": "0.0",
            "displayFolder": "Decision memory",
            "description": "Existing-order fulfilment outcome for the remembered decision. Unit: percentage points."
          }
        ]
      },
      {
        "name": "decision_case_actions",
        "description": "Bridge from decision cases to governed actions and receipts when approvals have executed.",
        "columns": [
          {
            "name": "caseId",
            "dataType": "string",
            "sourceColumn": "caseId",
            "summarizeBy": "none"
          },
          {
            "name": "actionId",
            "dataType": "string",
            "sourceColumn": "actionId",
            "summarizeBy": "none"
          },
          {
            "name": "receiptId",
            "dataType": "string",
            "sourceColumn": "receiptId",
            "summarizeBy": "none",
            "description": "Receipt proving the governed action was executed."
          }
        ],
        "partitions": [
          {
            "name": "decision_case_actions-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "decision_case_actions"
            }
          }
        ],
        "measures": [
          {
            "name": "Decision Actions Executed Count",
            "expression": "CALCULATE(\n    DISTINCTCOUNT('decision_case_actions'[actionId]),\n    KEEPFILTERS('governed_actions'[status] = \"executed\"),\n    KEEPFILTERS('governed_actions'[result] = \"success\")\n)",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of remembered decision actions that executed successfully through governed workflows. Unit: actions."
          },
          {
            "name": "Decision Receipt Count",
            "expression": "DISTINCTCOUNT('decision_case_actions'[receiptId])",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of receipts linked to remembered decision cases. Unit: receipts."
          }
        ]
      },
      {
        "name": "decision_case_campaigns",
        "description": "Bridge linking each decision case to the campaigns it concerns. The 2026 Hydration Sunscreen case spans the four signal-affected regional campaigns, so this relationship is many-to-many.",
        "columns": [
          {
            "name": "caseId",
            "dataType": "string",
            "sourceColumn": "caseId",
            "summarizeBy": "none"
          },
          {
            "name": "campaignId",
            "dataType": "string",
            "sourceColumn": "campaignId",
            "summarizeBy": "none"
          },
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "relationshipType",
            "dataType": "string",
            "sourceColumn": "relationshipType",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "decision_case_campaigns-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "decision_case_campaigns"
            }
          }
        ],
        "measures": [
          {
            "name": "Campaigns Affected By Decision Case",
            "expression": "DISTINCTCOUNT(+decision_case_campaigns+[campaignId])",
            "description": "Number of distinct campaigns linked to the decision cases in context. Evaluates to 4 for CASE-2026-HS-001, the four signal-affected regional campaigns. Unit: campaigns.",
            "formatString": "0"
          }
        ]
      }
