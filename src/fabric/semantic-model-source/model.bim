          }
        ]
      },
      {
        "name": "inventory_positions",
        "description": "Daily inventory availability, reservations and supply coverage by region and product.",
        "columns": [
          {
            "name": "snapshotDate",
            "dataType": "dateTime",
            "sourceColumn": "snapshotDate",
            "summarizeBy": "none"
          },
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "availableUnits",
            "dataType": "int64",
            "sourceColumn": "availableUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "reservedUnits",
            "dataType": "int64",
            "sourceColumn": "reservedUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "coverageDays",
            "dataType": "double",
            "sourceColumn": "coverageDays",
            "summarizeBy": "average",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "inventory_positions-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "inventory_positions"
            }
          }
        ],
        "measures": [
          {
            "name": "Supply Coverage Days",
            "expression": "AVERAGE('inventory_positions'[coverageDays])",
            "formatString": "0.0",
            "displayFolder": "Supply",
            "description": "Average supply coverage in the current region/product/date filter context. Unit: days."
          },
          {
            "name": "Latest Hero Supply Coverage Days",
            "expression": "VAR LastSnapshot =\n    CALCULATE(\n        MAX('inventory_positions'[snapshotDate]),\n        ALL('inventory_positions')\n    )\nRETURN\n    CALCULATE(\n        AVERAGE('inventory_positions'[coverageDays]),\n        KEEPFILTERS('products'[hero] = TRUE()),\n        'inventory_positions'[snapshotDate] = LastSnapshot\n    )",
            "formatString": "0.0",
            "displayFolder": "Supply",
            "description": "Latest Hydration Sunscreen supply coverage. Unit: days."
          }
        ]
      },
