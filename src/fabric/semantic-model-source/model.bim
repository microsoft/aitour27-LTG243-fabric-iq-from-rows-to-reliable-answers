            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "observationDate",
            "dataType": "dateTime",
            "sourceColumn": "observationDate",
            "summarizeBy": "none"
          },
          {
            "name": "uvIndexAnomaly",
            "dataType": "double",
            "sourceColumn": "uvIndexAnomaly",
            "summarizeBy": "average",
            "description": "UV index anomaly used by the approved weather uplift formula."
          },
          {
            "name": "temperatureMeanAnomalyC",
            "dataType": "double",
            "sourceColumn": "temperatureMeanAnomalyC",
            "summarizeBy": "average",
            "description": "Mean temperature anomaly in Celsius used by the approved weather uplift formula."
          },
          {
            "name": "betaUv",
            "dataType": "int64",
            "sourceColumn": "betaUv",
            "summarizeBy": "none"
          },
          {
            "name": "betaTempC",
            "dataType": "double",
            "sourceColumn": "betaTempC",
            "summarizeBy": "sum"
          },
          {
            "name": "modelledUpliftPct",
            "dataType": "double",
            "sourceColumn": "modelledUpliftPct",
            "summarizeBy": "average",
            "formatString": "0.0",
            "description": "Weather model uplift percent; window mean equals the observed Hydration Sunscreen sales variance."
          },
          {
            "name": "modelId",
            "dataType": "string",
            "sourceColumn": "modelId",
