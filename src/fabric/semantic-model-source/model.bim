      {
        "name": "WeatherForecastDaily",
        "description": "Decision-day and later weather forecasts by target date and region, used to assess whether the anomaly is likely to continue.",
        "columns": [
          {
            "name": "issueTimestamp",
            "dataType": "dateTime",
            "sourceColumn": "issueTimestamp",
            "summarizeBy": "none"
          },
          {
            "name": "issueDate",
            "dataType": "dateTime",
            "sourceColumn": "issueDate",
            "summarizeBy": "none",
            "description": "Forecast issue date; 2026-08-03 is the decision-day forecast."
          },
          {
            "name": "targetDate",
            "dataType": "dateTime",
            "sourceColumn": "targetDate",
            "summarizeBy": "none"
          },
          {
            "name": "leadDays",
            "dataType": "int64",
            "sourceColumn": "leadDays",
            "summarizeBy": "sum",
            "description": "Lead day from issue date to target date; decision day uses the 1..30 range."
          },
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "providerId",
            "dataType": "string",
            "sourceColumn": "providerId",
            "summarizeBy": "none"
          },
          {
            "name": "temperatureMeanC_p10",
            "dataType": "double",
            "sourceColumn": "temperatureMeanC_p10",
            "summarizeBy": "sum"
          },
          {
            "name": "temperatureMeanC_p50",
            "dataType": "double",
            "sourceColumn": "temperatureMeanC_p50",
            "summarizeBy": "sum"
          },
          {
            "name": "temperatureMeanC_p90",
            "dataType": "double",
            "sourceColumn": "temperatureMeanC_p90",
            "summarizeBy": "sum"
          },
          {
            "name": "uvIndex_p10",
            "dataType": "double",
            "sourceColumn": "uvIndex_p10",
            "summarizeBy": "sum"
          },
          {
            "name": "uvIndex_p50",
            "dataType": "double",
            "sourceColumn": "uvIndex_p50",
            "summarizeBy": "sum"
          },
          {
            "name": "uvIndex_p90",
            "dataType": "double",
            "sourceColumn": "uvIndex_p90",
            "summarizeBy": "sum"
          },
          {
            "name": "temperatureMeanAnomalyC_p50",
            "dataType": "double",
            "sourceColumn": "temperatureMeanAnomalyC_p50",
            "summarizeBy": "average"
          },
          {
            "name": "uvIndexAnomaly_p50",
            "dataType": "double",
            "sourceColumn": "uvIndexAnomaly_p50",
            "summarizeBy": "average"
          },
          {
            "name": "precipitationMm_p50",
            "dataType": "double",
            "sourceColumn": "precipitationMm_p50",
            "summarizeBy": "sum"
          },
          {
            "name": "confidence",
            "dataType": "double",
            "sourceColumn": "confidence",
            "summarizeBy": "average",
            "formatString": "0%"
          },
          {
            "name": "provenance",
            "dataType": "string",
            "sourceColumn": "provenance",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "WeatherForecastDaily-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "WeatherForecastDaily"
            }
          }
        ],
        "measures": [
          {
            "name": "Decision Day Forecast Target Days",
            "expression": "CALCULATE(\n    DISTINCTCOUNT('WeatherForecastDaily'[targetDate]),\n    KEEPFILTERS('WeatherForecastDaily'[issueDate] = DATE(2026, 8, 3))\n)",
            "formatString": "#,0",
            "displayFolder": "Weather",
            "description": "Number of target dates in the decision-day weather forecast horizon. Unit: days."
          },
          {
            "name": "Decision Day Forecast Mean UV Anomaly",
            "expression": "CALCULATE(\n    AVERAGE('WeatherForecastDaily'[uvIndexAnomaly_p50]),\n    KEEPFILTERS('WeatherForecastDaily'[issueDate] = DATE(2026, 8, 3))\n)",
            "formatString": "0.00",
            "displayFolder": "Weather",
            "description": "Mean p50 UV anomaly in the 2026-08-03 forecast horizon. Unit: UV index points."
          },
          {
            "name": "Decision Day Forecast Mean Temperature Anomaly C",
            "expression": "CALCULATE(\n    AVERAGE('WeatherForecastDaily'[temperatureMeanAnomalyC_p50]),\n    KEEPFILTERS('WeatherForecastDaily'[issueDate] = DATE(2026, 8, 3))\n)",
            "formatString": "0.00",
            "displayFolder": "Weather",
            "description": "Mean p50 temperature anomaly in the 2026-08-03 forecast horizon. Unit: degrees Celsius."
          },
          {
            "name": "Decision Day Forecast Confidence",
            "expression": "CALCULATE(\n    AVERAGE('WeatherForecastDaily'[confidence]),\n    KEEPFILTERS('WeatherForecastDaily'[issueDate] = DATE(2026, 8, 3))\n)",
            "formatString": "0%",
            "displayFolder": "Weather",
            "description": "Average confidence for the 2026-08-03 weather forecast horizon. Unit: probability."
          }
        ]
      },
