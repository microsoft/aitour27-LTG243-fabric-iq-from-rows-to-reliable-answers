{
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "defaultMode": "directLake",
    "sourceQueryCulture": "en-US",
    "discourageImplicitMeasures": true,
    "annotations": [
      {
        "name": "ScenarioVersion",
        "value": "3.0.0"
      },
      {
        "name": "StorageMode",
        "value": "Direct Lake over Lakehouse Delta tables"
      },
      {
        "name": "ConnectionPlaceholders",
        "value": "Replace {SQL_ENDPOINT_ID} and {LAKEHOUSE_ID}, or create with fabio --connection using the SQL analytics endpoint."
      },
      {
        "name": "DecisionMemoryAdditions",
        "value": "Includes decision cases, states, triggers, policies, corrections, outcomes and actions for decision memory."
      }
    ],
    "expressions": [
      {
        "name": "DatabaseQuery",
        "kind": "m",
        "expression": "let\n    database = Sql.Database(\"{SQL_ENDPOINT_ID}\", \"{LAKEHOUSE_ID}\")\nin\n    database"
      }
    ],
    "tables": [
      {
        "name": "regions",
        "description": "Commercial markets for Caldova products; signalAffected=true marks the four El Nino-affected regions and false marks the two control regions.",
        "columns": [
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "regionName",
            "dataType": "string",
            "sourceColumn": "regionName",
            "summarizeBy": "none"
          },
          {
            "name": "marketCode",
            "dataType": "string",
            "sourceColumn": "marketCode",
            "summarizeBy": "sum"
          },
          {
            "name": "signalAffected",
            "dataType": "boolean",
            "sourceColumn": "signalAffected",
            "summarizeBy": "none",
            "description": "True for Coastal, Southern, Delta and Island regions affected by SIG-ENSO-2026-07; false for Northern and Central controls."
          },
          {
            "name": "baselineForecastUnits30d",
            "dataType": "int64",
            "sourceColumn": "baselineForecastUnits30d",
            "summarizeBy": "sum"
          },
          {
            "name": "variancePct",
            "dataType": "double",
            "sourceColumn": "variancePct",
            "summarizeBy": "average",
            "formatString": "0.0",
            "description": "Frozen Hydration Sunscreen sales variance percent for the analysis window 2026-06-22 through 2026-08-02."
          },
          {
            "name": "incrementalUnits",
            "dataType": "int64",
            "sourceColumn": "incrementalUnits",
            "summarizeBy": "sum",
            "description": "Incremental Hydration Sunscreen units attributed to the climate signal in this region."
          }
        ],
        "partitions": [
          {
            "name": "regions-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "regions"
            }
          }
        ],
        "measures": [
          {
            "name": "Affected Region Count",
            "expression": "CALCULATE(\n    DISTINCTCOUNT('regions'[regionId]),\n    KEEPFILTERS('regions'[signalAffected] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Signal grounding",
            "description": "Number of regions affected by SIG-ENSO-2026-07. Unit: regions."
          },
          {
            "name": "Control Region Count",
            "expression": "CALCULATE(\n    DISTINCTCOUNT('regions'[regionId]),\n    KEEPFILTERS('regions'[signalAffected] = FALSE())\n)",
            "formatString": "#,0",
            "displayFolder": "Signal grounding",
            "description": "Number of unaffected control regions used to test whether uplift is global. Unit: regions."
          },
          {
            "name": "Hero Forecast Variance %",
            "expression": "VAR Numerator =\n    SUMX(\n        VALUES('regions'[regionId]),\n        CALCULATE(MAX('regions'[baselineForecastUnits30d]) * MAX('regions'[variancePct]))\n    )\nVAR Denominator =\n    SUMX(\n        VALUES('regions'[regionId]),\n        CALCULATE(MAX('regions'[baselineForecastUnits30d]))\n    )\nRETURN\n    DIVIDE(Numerator, Denominator)",
            "formatString": "0.0",
            "displayFolder": "Forecast",
            "description": "Hydration Sunscreen sales variance over 2026-06-22 to 2026-08-02. Per region it reproduces the frozen variancePct values. Unit: percentage points."
          },
          {
            "name": "Actual Sales Variance %",
            "expression": "[Hero Forecast Variance %]",
            "formatString": "0.0",
            "displayFolder": "Forecast",
            "description": "Observed Hydration Sunscreen variance used to reconcile weather uplift to actual sales. Unit: percentage points."
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "Signal-affected regions are REG-COASTAL, REG-SOUTH, REG-DELTA and REG-ISLAND; REG-NORTH and REG-CENTRAL are controls."
          }
        ]
      },
      {
        "name": "products",
        "description": "Caldova product catalogue; hero=true identifies PROD-HS-100, Hydration Sunscreen, the product used in the commercial launch analysis.",
        "columns": [
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "productName",
            "dataType": "string",
            "sourceColumn": "productName",
            "summarizeBy": "none",
            "description": "Business product name; includes Hydration Sunscreen."
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "handlingClass",
            "dataType": "string",
            "sourceColumn": "handlingClass",
            "summarizeBy": "sum"
          },
          {
            "name": "unitPriceUsd",
            "dataType": "double",
            "sourceColumn": "unitPriceUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0.00"
          },
          {
            "name": "hero",
            "dataType": "boolean",
            "sourceColumn": "hero",
            "summarizeBy": "none",
            "description": "True for the Hydration Sunscreen hero product PROD-HS-100."
          }
        ],
        "partitions": [
          {
            "name": "products-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "products"
            }
          }
        ],
        "measures": [
          {
            "name": "Hero Product Unit Price USD",
            "expression": "CALCULATE(\n    MAX('products'[unitPriceUsd]),\n    KEEPFILTERS('products'[hero] = TRUE())\n)",
            "formatString": "$#,0.00",
            "displayFolder": "Sales",
            "description": "Unit price for Hydration Sunscreen PROD-HS-100. Unit: US dollars per unit."
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "The hero product is PROD-HS-100 / Hydration Sunscreen where hero is true."
          }
        ]
      },
      {
        "name": "campaigns",
        "description": "Active Sun Care marketing campaigns by product, region and channel with base and incremental budgets.",
        "columns": [
          {
            "name": "campaignId",
            "dataType": "string",
            "sourceColumn": "campaignId",
            "summarizeBy": "none"
          },
          {
            "name": "launchPlanId",
            "dataType": "string",
            "sourceColumn": "launchPlanId",
            "summarizeBy": "none"
          },
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "campaignName",
            "dataType": "string",
            "sourceColumn": "campaignName",
            "summarizeBy": "none"
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "baseBudgetUsd",
            "dataType": "int64",
            "sourceColumn": "baseBudgetUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0"
          },
          {
            "name": "incrementalBudgetUsd",
            "dataType": "int64",
            "sourceColumn": "incrementalBudgetUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0"
          }
        ],
        "partitions": [
          {
            "name": "campaigns-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "campaigns"
            }
          }
        ],
        "measures": [
          {
            "name": "Campaign Base Budget USD",
            "expression": "SUM('campaigns'[baseBudgetUsd])",
            "formatString": "$#,0",
            "displayFolder": "Campaign performance",
            "description": "Base marketing campaign budget. Unit: US dollars."
          },
          {
            "name": "Campaign Incremental Budget USD",
            "expression": "SUM('campaigns'[incrementalBudgetUsd])",
            "formatString": "$#,0",
            "displayFolder": "Campaign performance",
            "description": "Incremental marketing campaign budget. Unit: US dollars."
          }
        ]
      },
      {
        "name": "launch_plans",
        "description": "Season launch plans that group campaigns, commitments and forecast activity for the Sun Care season.",
        "columns": [
          {
            "name": "launchPlanId",
            "dataType": "string",
            "sourceColumn": "launchPlanId",
            "summarizeBy": "none"
          },
          {
            "name": "planName",
            "dataType": "string",
            "sourceColumn": "planName",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "startsOn",
            "dataType": "dateTime",
            "sourceColumn": "startsOn",
            "summarizeBy": "none"
          },
          {
            "name": "endsOn",
            "dataType": "dateTime",
            "sourceColumn": "endsOn",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "launch_plans-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "launch_plans"
            }
          }
        ]
      },
      {
        "name": "forecast_versions",
        "description": "Forecast snapshots for Hydration Sunscreen, including the baseline and revised versions and the analysis window used for variance.",
        "columns": [
          {
            "name": "forecastVersionId",
            "dataType": "string",
            "sourceColumn": "forecastVersionId",
            "summarizeBy": "none"
          },
          {
            "name": "versionName",
            "dataType": "string",
            "sourceColumn": "versionName",
            "summarizeBy": "none"
          },
          {
            "name": "versionType",
            "dataType": "string",
            "sourceColumn": "versionType",
            "summarizeBy": "none"
          },
          {
            "name": "forecastDate",
            "dataType": "dateTime",
            "sourceColumn": "forecastDate",
            "summarizeBy": "none"
          },
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "horizonDays",
            "dataType": "int64",
            "sourceColumn": "horizonDays",
            "summarizeBy": "sum"
          },
          {
            "name": "analysisWindowStartDate",
            "dataType": "dateTime",
            "sourceColumn": "analysisWindowStartDate",
            "summarizeBy": "none"
          },
          {
            "name": "analysisWindowEndDate",
            "dataType": "dateTime",
            "sourceColumn": "analysisWindowEndDate",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "forecast_versions-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "forecast_versions"
            }
          }
        ],
        "measures": [
          {
            "name": "Forecast Horizon Days",
            "expression": "MAX('forecast_versions'[horizonDays])",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "description": "Forecast horizon length used by the Hydration Sunscreen baseline and revised forecasts. Unit: days."
          }
        ]
      },
      {
        "name": "forecast_lines",
        "description": "Thirty-day demand forecast quantities by forecast version, region and product.",
        "columns": [
          {
            "name": "forecastVersionId",
            "dataType": "string",
            "sourceColumn": "forecastVersionId",
            "summarizeBy": "none"
          },
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "forecastUnits",
            "dataType": "int64",
            "sourceColumn": "forecastUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "horizonDays",
            "dataType": "int64",
            "sourceColumn": "horizonDays",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "forecast_lines-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "forecast_lines"
            }
          }
        ],
        "measures": [
          {
            "name": "Forecast Baseline Units 30d",
            "expression": "CALCULATE(\n    SUM('forecast_lines'[forecastUnits]),\n    KEEPFILTERS('forecast_versions'[versionType] = \"baseline\"),\n    KEEPFILTERS('products'[hero] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "description": "Baseline 30-day forecast units for Hydration Sunscreen. Unit: units."
          }
        ]
      },
      {
        "name": "forecast_assumptions",
        "description": "Business assumptions behind each forecast version, including assumptions invalidated by the climate signal.",
        "columns": [
          {
            "name": "assumptionId",
            "dataType": "string",
            "sourceColumn": "assumptionId",
            "summarizeBy": "none"
          },
          {
            "name": "forecastVersionId",
            "dataType": "string",
            "sourceColumn": "forecastVersionId",
            "summarizeBy": "none"
          },
          {
            "name": "statement",
            "dataType": "string",
            "sourceColumn": "statement",
            "summarizeBy": "none"
          },
          {
            "name": "heldAfterSignal",
            "dataType": "boolean",
            "sourceColumn": "heldAfterSignal",
            "summarizeBy": "none"
          },
          {
            "name": "invalidatedBySignalId",
            "dataType": "string",
            "sourceColumn": "invalidatedBySignalId",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "forecast_assumptions-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "forecast_assumptions"
            }
          }
        ]
      },
      {
        "name": "campaign_scenarios",
        "description": "Commercial investment scenarios, expected incremental demand and revenue, recommendation status, approval status and policy blocks.",
        "columns": [
          {
            "name": "scenarioId",
            "dataType": "string",
            "sourceColumn": "scenarioId",
            "summarizeBy": "none"
          },
          {
            "name": "scenarioName",
            "dataType": "string",
            "sourceColumn": "scenarioName",
            "summarizeBy": "none"
          },
          {
            "name": "incrementalBudgetUsd",
            "dataType": "int64",
            "sourceColumn": "incrementalBudgetUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0"
          },
          {
            "name": "incrementalUnits",
            "dataType": "int64",
            "sourceColumn": "incrementalUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "incrementalRevenueUsd",
            "dataType": "int64",
            "sourceColumn": "incrementalRevenueUsd",
            "summarizeBy": "sum"
          },
          {
            "name": "confidence",
            "dataType": "double",
            "sourceColumn": "confidence",
            "summarizeBy": "average",
            "formatString": "0%"
          },
          {
            "name": "supplyFeasible",
            "dataType": "boolean",
            "sourceColumn": "supplyFeasible",
            "summarizeBy": "none"
          },
          {
            "name": "recommended",
            "dataType": "boolean",
            "sourceColumn": "recommended",
            "summarizeBy": "none",
            "description": "True for the recommended commercial investment scenario."
          },
          {
            "name": "approved",
            "dataType": "boolean",
            "sourceColumn": "approved",
            "summarizeBy": "none",
            "description": "True only after a selected commercial scenario has a governed approval. In the default as-of dataset, SCN-2026-HS-B is recommended but not approved."
          },
          {
            "name": "campaignStartsOn",
            "dataType": "dateTime",
            "sourceColumn": "campaignStartsOn",
            "summarizeBy": "none",
            "description": "First day of the proposed campaign window."
          },
          {
            "name": "campaignEndsOn",
            "dataType": "dateTime",
            "sourceColumn": "campaignEndsOn",
            "summarizeBy": "none",
            "description": "Last day of the proposed campaign window."
          },
          {
            "name": "forecastHorizonEndsOn",
            "dataType": "dateTime",
            "sourceColumn": "forecastHorizonEndsOn",
            "summarizeBy": "none",
            "description": "Last day covered by the 30-day weather forecast issued on the decision day. It ends before the campaign does, so the remaining horizon rests on the seasonal outlook rather than the daily forecast."
          },
          {
            "name": "blockedByPolicyId",
            "dataType": "string",
            "sourceColumn": "blockedByPolicyId",
            "summarizeBy": "none"
          },
          {
            "name": "blockedByPolicyVersion",
            "dataType": "double",
            "sourceColumn": "blockedByPolicyVersion",
            "summarizeBy": "none"
          },
          {
            "name": "rationale",
            "dataType": "string",
            "sourceColumn": "rationale",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "campaign_scenarios-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "campaign_scenarios"
            }
          }
        ],
        "measures": [
          {
            "name": "Opportunity Incremental Units",
            "expression": "CALCULATE(\n    SUM('campaign_scenarios'[incrementalUnits]),\n    KEEPFILTERS('campaign_scenarios'[recommended] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Opportunity",
            "description": "Incremental units in recommended scenario SCN-2026-HS-B. This is an opportunity, not an approved commitment. Unit: units."
          },
          {
            "name": "Opportunity Incremental Revenue USD",
            "expression": "CALCULATE(\n    SUM('campaign_scenarios'[incrementalRevenueUsd]),\n    KEEPFILTERS('campaign_scenarios'[recommended] = TRUE())\n)",
            "formatString": "$#,0",
            "displayFolder": "Opportunity",
            "description": "Incremental revenue in recommended scenario SCN-2026-HS-B. This is an opportunity, not an approved commitment. Unit: US dollars."
          },
          {
            "name": "Recommended Scenario Budget USD",
            "expression": "CALCULATE(\n    SUM('campaign_scenarios'[incrementalBudgetUsd]),\n    KEEPFILTERS('campaign_scenarios'[recommended] = TRUE())\n)",
            "formatString": "$#,0",
            "displayFolder": "Opportunity",
            "description": "Incremental campaign budget requested by recommended scenario SCN-2026-HS-B. The budget remains unallocated until approval. Unit: US dollars."
          },
          {
            "name": "Recommended Scenario Confidence",
            "expression": "CALCULATE(\n    MAX('campaign_scenarios'[confidence]),\n    KEEPFILTERS('campaign_scenarios'[recommended] = TRUE())\n)",
            "formatString": "0%",
            "displayFolder": "Opportunity",
            "description": "Confidence score for recommended campaign scenario SCN-2026-HS-B. Unit: probability."
          },
          {
            "name": "Aggressive Scenario Budget USD",
            "expression": "CALCULATE(\n    SUM('campaign_scenarios'[incrementalBudgetUsd]),\n    KEEPFILTERS('campaign_scenarios'[scenarioId] = \"SCN-2026-HS-C\")\n)",
            "formatString": "$#,0",
            "displayFolder": "Opportunity",
            "description": "Incremental budget requested by the blocked aggressive scenario. Unit: US dollars."
          }
        ]
      },
      {
        "name": "campaign_commitments",
        "description": "Commercial commitments created only after a governed approval and tied to product, launch plan and origin signal. The default as-of dataset has no approved Hydration Sunscreen commitment.",
        "columns": [
          {
            "name": "commitmentId",
            "dataType": "string",
            "sourceColumn": "commitmentId",
            "summarizeBy": "none"
          },
          {
            "name": "scenarioId",
            "dataType": "string",
            "sourceColumn": "scenarioId",
            "summarizeBy": "none"
          },
          {
            "name": "launchPlanId",
            "dataType": "string",
            "sourceColumn": "launchPlanId",
            "summarizeBy": "none"
          },
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "committedUnits",
            "dataType": "int64",
            "sourceColumn": "committedUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "committedRevenueUsd",
            "dataType": "int64",
            "sourceColumn": "committedRevenueUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0"
          },
          {
            "name": "approvedByRole",
            "dataType": "string",
            "sourceColumn": "approvedByRole",
            "summarizeBy": "none"
          },
          {
            "name": "approvedAt",
            "dataType": "dateTime",
            "sourceColumn": "approvedAt",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "originSignalId",
            "dataType": "string",
            "sourceColumn": "originSignalId",
            "summarizeBy": "none"
          },
          {
            "name": "originCaseId",
            "dataType": "string",
            "sourceColumn": "originCaseId",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "campaign_commitments-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "campaign_commitments"
            }
          }
        ],
        "measures": [
          {
            "name": "Campaign Commitment Units",
            "expression": "CALCULATE(\n    SUM('campaign_commitments'[committedUnits]),\n    KEEPFILTERS('campaign_commitments'[status] = \"approved\")\n)",
            "formatString": "#,0",
            "displayFolder": "Commitment",
            "description": "Approved Hydration Sunscreen campaign commitment when an approval exists. Unit: units."
          },
          {
            "name": "Campaign Commitment Revenue USD",
            "expression": "CALCULATE(\n    SUM('campaign_commitments'[committedRevenueUsd]),\n    KEEPFILTERS('campaign_commitments'[status] = \"approved\")\n)",
            "formatString": "$#,0",
            "displayFolder": "Commitment",
            "description": "Approved Hydration Sunscreen committed revenue when an approval exists. Unit: US dollars."
          },
          {
            "name": "Planned Incremental Units",
            "expression": "[Campaign Commitment Units]",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Planned incremental Hydration Sunscreen units from an approved commitment when the outcome slice is loaded. Unit: units."
          },
          {
            "name": "Planned Incremental Revenue USD",
            "expression": "[Campaign Commitment Revenue USD]",
            "formatString": "$#,0",
            "displayFolder": "Decision memory",
            "description": "Planned incremental Hydration Sunscreen revenue from an approved commitment when the outcome slice is loaded. Unit: US dollars."
          },
          {
            "name": "Delivered Incremental Units",
            "expression": "[Outcome Delivered Incremental Units]",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Delivered units from recorded outcomes when the outcome slice is loaded. Unit: units."
          },
          {
            "name": "Realised Incremental Revenue USD",
            "expression": "[Outcome Realised Incremental Revenue USD]",
            "formatString": "$#,0",
            "displayFolder": "Decision memory",
            "description": "Realised revenue from recorded outcomes when the outcome slice is loaded. Unit: US dollars."
          },
          {
            "name": "Existing Order Fulfilment %",
            "expression": "[Outcome Existing Order Fulfilment %]",
            "formatString": "0.0",
            "displayFolder": "Decision memory",
            "description": "Existing-order fulfilment from recorded outcomes when the outcome slice is loaded. Unit: percentage points."
          }
        ]
      },
      {
        "name": "scenario_region_allocation",
        "description": "Regional allocation of each campaign scenario by units, revenue, budget and impact weight.",
        "columns": [
          {
            "name": "scenarioId",
