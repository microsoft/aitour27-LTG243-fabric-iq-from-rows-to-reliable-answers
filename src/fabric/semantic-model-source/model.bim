      {
        "name": "decision_cases",
        "description": "Decision case register for Caldova decisions; includes open CASE-2026-HS-001 plus historical background cases for retrieval and reuse.",
        "columns": [
          {
            "name": "caseId",
            "dataType": "string",
            "sourceColumn": "caseId",
            "summarizeBy": "none",
            "description": "Decision case identifier; CASE-2026-HS-001 is the open Hydration Sunscreen case."
          },
          {
            "name": "title",
            "dataType": "string",
            "sourceColumn": "title",
            "summarizeBy": "none"
          },
          {
            "name": "scopeKey",
            "dataType": "string",
            "sourceColumn": "scopeKey",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "concernsProductId",
            "dataType": "string",
            "sourceColumn": "concernsProductId",
            "summarizeBy": "none",
            "description": "Product that the decision case concerns."
          },
          {
            "name": "openedAt",
            "dataType": "dateTime",
            "sourceColumn": "openedAt",
            "summarizeBy": "none"
          },
          {
            "name": "resolvedAt",
            "dataType": "dateTime",
            "sourceColumn": "resolvedAt",
            "summarizeBy": "none"
          },
          {
            "name": "originSignalId",
            "dataType": "string",
            "sourceColumn": "originSignalId",
            "summarizeBy": "none",
            "description": "External signal that opened or informed the case when applicable."
          },
          {
            "name": "lineId",
            "dataType": "string",
            "sourceColumn": "lineId",
            "summarizeBy": "none"
          },
          {
            "name": "commitmentId",
            "dataType": "string",
            "sourceColumn": "commitmentId",
            "summarizeBy": "none",
            "description": "Campaign commitment created by the decision when applicable. Blank means no commitment has been approved yet."
          }
        ],
        "partitions": [
          {
            "name": "decision_cases-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "decision_cases"
            }
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "CASE-2026-HS-001 is open in the default as-of dataset; historical cases provide retrieval background."
          }
        ],
        "measures": [
          {
            "name": "Decision Case Count",
            "expression": "DISTINCTCOUNT('decision_cases'[caseId])",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of remembered decision cases in the current filter context. Unit: cases."
          },
          {
            "name": "Resolved Decision Case Count",
            "expression": "CALCULATE(\n    [Decision Case Count],\n    KEEPFILTERS('decision_cases'[status] = \"resolved\")\n)",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of remembered decision cases with resolved status. Unit: cases."
          },
          {
            "name": "Open Decision Case Count",
            "expression": "CALCULATE(\n    [Decision Case Count],\n    FILTER('decision_cases', 'decision_cases'[status] <> \"resolved\")\n)",
            "formatString": "#,0",
            "displayFolder": "Decision memory",
            "description": "Number of remembered decision cases not yet resolved. Unit: cases."
          },
          {
            "name": "Average Days to Resolve",
            "expression": "AVERAGEX(\n    FILTER('decision_cases', NOT ISBLANK('decision_cases'[resolvedAt])),\n    DATEDIFF('decision_cases'[openedAt], 'decision_cases'[resolvedAt], DAY)\n)",
            "formatString": "0.0",
            "displayFolder": "Decision memory",
            "description": "Average elapsed time from case open to resolution for resolved decision cases. Unit: days."
          }
        ]
      },
      {
        "name": "decision_case_states",
        "description": "State-transition history for each decision case, from opened through approval, execution and resolution.",
        "columns": [
          {
            "name": "caseId",
            "dataType": "string",
            "sourceColumn": "caseId",
            "summarizeBy": "none"
          },
          {
            "name": "sequence",
            "dataType": "int64",
            "sourceColumn": "sequence",
            "summarizeBy": "sum",
            "formatString": "#,0"
          },
          {
            "name": "state",
            "dataType": "string",
            "sourceColumn": "state",
            "summarizeBy": "none"
          },
          {
            "name": "changedAt",
            "dataType": "dateTime",
            "sourceColumn": "changedAt",
            "summarizeBy": "none"
          },
          {
            "name": "actorRole",
            "dataType": "string",
            "sourceColumn": "actorRole",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "decision_case_states-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "decision_case_states"
            }
          }
        ]
      },
      {
        "name": "decision_case_triggers",
        "description": "Trigger facts that explain why a decision case opened, including forecast variance and external signal triggers.",
