            "expression": "CALCULATE(\n    [Total Units],\n    KEEPFILTERS('products'[hero] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "Hydration Sunscreen units sold, filtered by products[hero]=true. Unit: units."
          },
          {
            "name": "Hero Product Revenue USD",
            "expression": "CALCULATE(\n    [Total Revenue USD],\n    KEEPFILTERS('products'[hero] = TRUE())\n)",
            "formatString": "$#,0",
            "displayFolder": "Sales",
            "description": "Hydration Sunscreen revenue, filtered by products[hero]=true. Unit: US dollars."
          }
        ]
      },
