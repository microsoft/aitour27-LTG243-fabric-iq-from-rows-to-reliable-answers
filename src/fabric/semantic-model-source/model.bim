        "partitions": [
          {
            "name": "production_options-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "production_options"
            }
          }
        ],
        "measures": [
          {
            "name": "Max Deliverable Incremental Units Under Best Plan",
            "expression": "CALCULATE(\n    MAX('production_options'[availableIncrementalUnits]),\n    KEEPFILTERS('production_options'[optionId] = \"OPT-4\")\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Available incremental units under the recommended OPT-4 plan. Unit: units."
          },
          {
            "name": "Recommended Option Incremental Units Delivered",
            "expression": "CALCULATE(\n    MAX('production_options'[incrementalUnitsDelivered]),\n    KEEPFILTERS('production_options'[recommended] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Incremental units delivered by the recommended production option. Unit: units."
          },
          {
            "name": "Recommended Option Shortfall Units",
            "expression": "CALCULATE(\n    MAX('production_options'[shortfallUnits]),\n    KEEPFILTERS('production_options'[recommended] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Shortfall for the recommended production option. Unit: units."
          },
          {
            "name": "Recommended Option Confidence",
            "expression": "CALCULATE(\n    MAX('production_options'[confidence]),\n    KEEPFILTERS('production_options'[recommended] = TRUE())\n)",
            "formatString": "0%",
            "displayFolder": "Capacity",
            "description": "Confidence for the recommended production option OPT-4. Unit: probability."
          }
        ],
        "annotations": [
          {
            "name": "AgentGroundingNote",
            "value": "OPT-4 is the recommended reduced-rate higher-utilisation plan."
          }
        ]
      },
      {
        "name": "capacity_plan",
        "description": "Daily campaign capacity plan for PKG-02 comparing baseline and recommended production variants, maintenance days and existing commitments.",
        "columns": [
          {
            "name": "planVariant",
            "dataType": "string",
            "sourceColumn": "planVariant",
            "summarizeBy": "none"
          },
          {
            "name": "planDate",
            "dataType": "dateTime",
            "sourceColumn": "planDate",
            "summarizeBy": "none"
          },
          {
            "name": "lineId",
            "dataType": "string",
            "sourceColumn": "lineId",
            "summarizeBy": "none"
          },
          {
            "name": "scheduledHours",
            "dataType": "int64",
            "sourceColumn": "scheduledHours",
            "summarizeBy": "sum"
          },
          {
            "name": "utilisation",
            "dataType": "double",
            "sourceColumn": "utilisation",
            "summarizeBy": "none"
          },
          {
            "name": "rateFactor",
            "dataType": "double",
            "sourceColumn": "rateFactor",
            "summarizeBy": "average"
          },
          {
            "name": "plannedUnits",
            "dataType": "int64",
            "sourceColumn": "plannedUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "isMaintenanceDay",
            "dataType": "boolean",
            "sourceColumn": "isMaintenanceDay",
            "summarizeBy": "none",
            "description": "True for dates in the maintenance window that remove capacity from the campaign."
          },
          {
            "name": "maintenanceWindowId",
            "dataType": "string",
            "sourceColumn": "maintenanceWindowId",
            "summarizeBy": "none"
          },
          {
            "name": "optionId",
            "dataType": "string",
            "sourceColumn": "optionId",
            "summarizeBy": "none"
          },
          {
            "name": "commitmentId",
            "dataType": "string",
            "sourceColumn": "commitmentId",
            "summarizeBy": "none"
          },
          {
            "name": "existingCommittedUnits",
            "dataType": "int64",
            "sourceColumn": "existingCommittedUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "campaignCommitmentUnits",
            "dataType": "int64",
            "sourceColumn": "campaignCommitmentUnits",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "capacity_plan-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "capacity_plan"
            }
          }
        ],
        "measures": [
          {
            "name": "Campaign Capacity Without Maintenance Units",
            "expression": "CALCULATE(\n    SUM('capacity_plan'[plannedUnits]),\n    KEEPFILTERS('capacity_plan'[planVariant] = \"baseline\")\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "PKG-02 campaign capacity before removing the five maintenance days. Unit: units."
          },
          {
            "name": "Maintenance Capacity Lost Units",
            "expression": "CALCULATE(\n    SUM('capacity_plan'[plannedUnits]),\n    KEEPFILTERS('capacity_plan'[planVariant] = \"baseline\"),\n    KEEPFILTERS('capacity_plan'[isMaintenanceDay] = TRUE())\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Capacity removed by the five-day maintenance window. Unit: units."
          },
          {
            "name": "Campaign Capacity With Maintenance Units",
            "expression": "[Campaign Capacity Without Maintenance Units] - [Maintenance Capacity Lost Units]",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "PKG-02 baseline campaign capacity after removing the maintenance window. Unit: units."
          },
          {
            "name": "Existing Commitments Units",
            "expression": "CALCULATE(\n    MAX('capacity_plan'[existingCommittedUnits]),\n    KEEPFILTERS('capacity_plan'[planVariant] = \"baseline\")\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Existing committed units in the campaign before the recommended Hydration Sunscreen opportunity. Unit: units."
          },
          {
            "name": "Headroom Without Maintenance Units",
            "expression": "[Campaign Capacity Without Maintenance Units] - [Existing Commitments Units]",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Available campaign capacity before maintenance is considered. Unit: units."
          },
          {
            "name": "Capacity Headroom Units",
            "expression": "[Campaign Capacity With Maintenance Units] - [Existing Commitments Units]",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Available campaign capacity after maintenance is considered. Unit: units."
          },
          {
            "name": "Required Incremental Units",
            "expression": "[Opportunity Incremental Units]",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Incremental Hydration Sunscreen units required to satisfy the recommended opportunity. This is not an approved commitment until a commitment exists. Unit: units."
          },
          {
            "name": "Capacity Shortfall Units",
            "expression": "MAX(\n    0,\n    [Required Incremental Units] - [Capacity Headroom Units]\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Unmet recommended opportunity units after considering maintenance-constrained headroom. Unit: units."
          },
          {
            "name": "Recommended Plan Capacity Units",
            "expression": "CALCULATE(\n    SUM('capacity_plan'[plannedUnits]),\n    KEEPFILTERS('capacity_plan'[planVariant] IN { \"recommended\", \"approved\" })\n)",
            "formatString": "#,0",
            "displayFolder": "Capacity",
            "description": "Campaign capacity under the recommended OPT-4 production plan. Unit: units."
          }
        ]
      },
