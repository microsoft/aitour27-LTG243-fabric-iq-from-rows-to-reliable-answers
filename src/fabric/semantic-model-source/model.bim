      {
        "name": "CampaignSignals",
        "description": "Hourly campaign telemetry with spend, attributed units, revenue and contribution margin.",
        "columns": [
          {
            "name": "timestamp",
            "dataType": "dateTime",
            "sourceColumn": "timestamp",
            "summarizeBy": "none"
          },
          {
            "name": "campaignId",
            "dataType": "string",
            "sourceColumn": "campaignId",
            "summarizeBy": "none"
          },
          {
            "name": "regionId",
            "dataType": "string",
            "sourceColumn": "regionId",
            "summarizeBy": "none"
          },
          {
            "name": "productId",
            "dataType": "string",
            "sourceColumn": "productId",
            "summarizeBy": "none"
          },
          {
            "name": "impressions",
            "dataType": "int64",
            "sourceColumn": "impressions",
            "summarizeBy": "sum"
          },
          {
            "name": "engagements",
            "dataType": "int64",
            "sourceColumn": "engagements",
            "summarizeBy": "sum"
          },
          {
            "name": "spendUsd",
            "dataType": "double",
            "sourceColumn": "spendUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0"
          },
          {
            "name": "attributedUnits",
            "dataType": "int64",
            "sourceColumn": "attributedUnits",
            "summarizeBy": "sum"
          },
          {
            "name": "revenueUsd",
            "dataType": "int64",
            "sourceColumn": "revenueUsd",
            "summarizeBy": "sum",
            "formatString": "$#,0"
          },
          {
            "name": "contributionMarginPct",
            "dataType": "double",
            "sourceColumn": "contributionMarginPct",
            "summarizeBy": "average",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "CampaignSignals-directlake",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "CampaignSignals"
            }
          }
        ],
        "measures": [
          {
            "name": "Campaign Spend USD",
            "expression": "SUM('CampaignSignals'[spendUsd])",
            "formatString": "$#,0",
            "displayFolder": "Campaign performance",
            "description": "Campaign telemetry spend in the current filter context. Unit: US dollars."
          },
          {
            "name": "Campaign Attributed Units",
            "expression": "SUM('CampaignSignals'[attributedUnits])",
            "formatString": "#,0",
            "displayFolder": "Campaign performance",
            "description": "Campaign-attributed units from telemetry. Unit: units."
          },
          {
            "name": "Campaign Revenue USD",
            "expression": "SUM('CampaignSignals'[revenueUsd])",
            "formatString": "$#,0",
            "displayFolder": "Campaign performance",
            "description": "Campaign-attributed revenue from telemetry. Unit: US dollars."
          },
          {
            "name": "Campaign Contribution Margin %",
            "expression": "DIVIDE(\n    SUMX(\n        'CampaignSignals',\n        'CampaignSignals'[revenueUsd] * 'CampaignSignals'[contributionMarginPct]\n    ),\n    SUM('CampaignSignals'[revenueUsd])\n)",
            "formatString": "0.0",
            "displayFolder": "Campaign performance",
            "description": "Revenue-weighted campaign contribution margin. Unit: percentage points."
          }
        ]
      },
