.create-merge table WeatherObservationsDaily (timestamp:datetime, regionId:string, stationId:string, temperatureMinC:real, temperatureMaxC:real, temperatureMeanC:real, feelsLikeC:real, heatIndexC:real, uvIndex:real, uvAlertLevel:string, humidityPct:real, precipitationMm:real, rainDay:bool, cloudCoverPct:real, sunshineHours:real, windSpeedKph:real, seaSurfaceTemperatureC:real, pressureHpa:real, temperatureMeanAnomalyC:real, uvIndexAnomaly:real, humidityAnomalyPct:real, precipitationAnomalyMm:real, sunshineAnomalyHours:real, seaSurfaceAnomalyC:real, provenance:string, providerId:string)
.create-merge table WeatherObservationsHourly (timestamp:datetime, regionId:string, stationId:string, temperatureC:real, feelsLikeC:real, uvIndex:real, humidityPct:real, precipitationMm:real, cloudCoverPct:real, windSpeedKph:real, pressureHpa:real, provenance:string)
.create-merge table WeatherForecastDaily (issueTimestamp:datetime, issueDate:datetime, targetDate:datetime, leadDays:int, regionId:string, providerId:string, temperatureMeanC_p10:real, temperatureMeanC_p50:real, temperatureMeanC_p90:real, uvIndex_p10:real, uvIndex_p50:real, uvIndex_p90:real, temperatureMeanAnomalyC_p50:real, uvIndexAnomaly_p50:real, precipitationMm_p50:real, confidence:real, provenance:string)
.create-merge table WeatherEvents (eventId:string, eventType:string, regionId:string, severity:string, startDate:datetime, endDate:datetime, peakValue:real, peakMetric:string, signalId:string, relevantToHeroProduct:bool, headline:string, provenance:string, providerId:string)
